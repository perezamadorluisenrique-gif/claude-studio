{
  "name": "claude-studio",
  "version": "0.1.4",
  "description": "Claude Studio for Obsidian - Notion-style AI writing, chat and vault tools powered by your local Claude Code CLI.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test 'tests/*.test.ts'",
    "version": "node version-bump.mjs && git add manifest.json versions.json CHANGELOG.md"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.0",
    "esbuild": "0.17.3",
    "eslint": "^9.39.5",
    "obsidian": "^1.13.1",
    "tslib": "2.4.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
